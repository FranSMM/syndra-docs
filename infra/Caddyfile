api.syndradata.com {
	# /metrics belongs to Prometheus, which reaches it over syndra_net without
	# ever passing through Caddy. From the internet it must not exist: the
	# response enumerates every route, its latency distribution and the size of
	# the corpus: internal topology and business volume handed to whoever asks.
	# Prometheus ships no authentication of its own, so the block lives here.
	#
	# handle blocks rather than a bare respond: they are mutually exclusive and
	# evaluated in the order written, so this cannot be silently reordered
	# behind reverse_proxy by Caddy's directive sorting.
	@metrics path /metrics /metrics/*
	handle @metrics {
		respond 403
	}

	handle {
		reverse_proxy syndra_api:8000
	}
}

# The Streamlit demo, self-hosted to drop the third-party dependency and the
# cold start of Streamlit Cloud's free tier. reverse_proxy upgrades WebSocket
# connections on its own, which Streamlit needs for every interaction.
demo.syndradata.com {
	reverse_proxy syndra_demo:8501
}
